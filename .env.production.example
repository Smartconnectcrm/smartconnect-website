# =============================================================================
# SmartConnect CRM - Production Environment Variables
# =============================================================================
# Configure these in Vercel Dashboard → Settings → Environment Variables
# Scope: Production
# =============================================================================

# REQUIRED - Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.smartconnectcrm.eu

# REQUIRED - CSP Mode (recommended: "enforce")
CSP_MODE=enforce

# OPTIONAL - Database connection (if using contact form with persistence)
# DATABASE_URL=postgresql://user:password@host:5432/smartconnect_crm

# OPTIONAL - SMTP configuration (if using email notifications)
# SMTP_HOST=smtp.eu.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.smartconnectcrm.eu
# SMTP_PASSWORD=your-mailgun-password
# SMTP_FROM=noreply@smartconnectcrm.eu
# SMTP_TO=contact@smartconnectcrm.eu

# OPTIONAL - Admin API key (if using admin panel)
# ADMIN_API_KEY=generate-with-openssl-rand-base64-32
